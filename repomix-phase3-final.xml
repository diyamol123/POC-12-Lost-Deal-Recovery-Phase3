        type: "value",
        name: "%",

        min: 0,
        max: 100,

        axisLabel: {
          color: "#64748b",
        },

        splitLine: {
          show: false,
        },
      },
    ],

    series: [
      {
        name: "Lost Deals",
        type: "bar",
        data: paretoValues,

        barMaxWidth: 36,

        itemStyle: {
          color: "#38bdf8",
          borderRadius: [5, 5, 0, 0],
        },
      },

      {
        name: "Cumulative",
