              <div className="mt-2 flex flex-wrap gap-2">
                {result.evidence.record_ids.map((id) => (
                  <span
                    key={id}
                    className="rounded-full border border-[#1F2937] px-2 py-1 text-[10px] text-slate-400"
                  >
                    {id}
                  </span>
                ))}
