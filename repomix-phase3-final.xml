    desc = sorted(results, key=lambda r: r["priority_rank"], reverse=True)

    assert asc[0]["priority_rank"] <= asc[-1]["priority_rank"]
    assert desc[0]["priority_rank"] >= desc[-1]["priority_rank"]


def test_pagination_contract():
