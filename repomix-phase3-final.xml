              to missed opportunities. Click a reason for
              intelligence.
            </p>
          </div>

          <ReactECharts
            option={paretoOption}
            style={{
              height: 300,
              width: "100%",
            }}
            opts={{
              renderer: "canvas",
            }}
            onEvents={{
              click: (params: {
                seriesType?: string;
                dataIndex?: number;
              }) => {
                if (
