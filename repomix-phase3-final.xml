    },
    "H Text & Theme Intelligence": {
        "status": "Conditionally supported",
        "evidence": "text_value contains action text, but the dataset is only 20 records and therefore provides limited text coverage for reliable theme analysis."
    }
}

readiness = {
    "source_of_truth": "data/canonical/intelligence_data.csv",
    "record_count": int(len(df)),
    "primary_data_archetype": {
