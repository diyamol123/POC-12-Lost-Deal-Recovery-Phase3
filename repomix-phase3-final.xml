        row["is_synthetic"] = row["is_synthetic"].lower() == "true"

        records.append(row)

    with OUTPUT.open("w", encoding="utf-8") as f:
        json.dump(records, f, indent=2, ensure_ascii=False)
        f.write("\n")

    print(f"Created {OUTPUT}")
