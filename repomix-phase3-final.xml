      deal.id,
      deal.date,
      deal.location,
      deal.team,
      deal.product,
      deal.company,
      deal.segment,
      deal.reason,
      deal.competitor,
      deal.stage,
      deal.value,
      deal.priority,
      deal.action,
    ]);

    const csv = [
      headers,
      ...rows,
    ]
