            &lt;div className=&quot;h-24 rounded-2xl bg-[#0B1117]&quot; /&gt;
            &lt;div className=&quot;h-24 rounded-2xl bg-[#0B1117]&quot; /&gt;
            &lt;div className=&quot;h-24 rounded-2xl bg-[#0B1117]&quot; /&gt;
          &lt;/div&gt;
          &lt;div className=&quot;h-96 rounded-2xl bg-[#0B1117]&quot; /&gt;
        &lt;/div&gt;
      &lt;/main&gt;
    );
