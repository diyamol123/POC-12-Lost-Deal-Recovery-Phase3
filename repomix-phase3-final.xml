  priority_rank: number;
  finding: string;
  evidence: IntelligenceEvidence;
  method_version: string;
  data_version: string;
  generated_at: string;
  quality_status: string;
  limitation: string;
};

export type IntelligenceSummary = {
  project_id: string;
  project_title: string;
  approved_track: string;
  primary_question: string;
  decision: string;
  data_version: string;
  method_version: string;
  result_count: number;
