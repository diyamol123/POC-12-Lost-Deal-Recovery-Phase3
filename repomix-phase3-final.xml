      </header>

      <div className="mx-auto max-w-[1600px] px-5 py-6 lg:px-8">

        {/* SOURCE NOTE */}

        <div className="mb-5 flex items-start gap-3 rounded-xl border border-[#38BDF8]/15 bg-[#38BDF8]/5 p-4">
