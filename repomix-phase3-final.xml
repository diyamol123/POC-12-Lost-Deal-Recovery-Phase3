  if (loading || state === &quot;loading&quot;) {
    return (
      &lt;main className=&quot;min-h-screen bg-[#030712] p-5 text-slate-100&quot;&gt;
        &lt;div className=&quot;mx-auto max-w-[1400px] animate-pulse space-y-4&quot;&gt;
