              className="mt-5 w-full rounded-lg border border-[#38BDF8]/30 bg-[#38BDF8]/10 px-4 py-3 text-xs font-semibold tracking-widest text-[#38BDF8] transition hover:bg-[#38BDF8]/20"
            >
              CLOSE
            </button>

          </div>

        </div>
      )}

    </main>
