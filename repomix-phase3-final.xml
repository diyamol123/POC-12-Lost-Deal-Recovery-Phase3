required = [
    "record_id", "record_type", "source_name",
    "is_synthetic", "data_version"
]

checks = {
    "completeness": {
        col: int(df[col].isna().sum())
        for col in required
    },
    "uniqueness": {
        "record_id_unique": bool(df["record_id"].is_unique),
        "duplicate_record_ids": int(df["record_id"].duplicated().sum())
    },
