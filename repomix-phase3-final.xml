        lineStyle: {
          color: "#1f2937",
        },
      },
    },

    visualMap: {
      min: 0,
      max: heatmapMax,

      calculable: true,

      orient: "horizontal",
      left: "center",
      bottom: 0,

      textStyle: {
        color: "#64748b",
      },
    },

    series: [
