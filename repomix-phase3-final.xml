            </div>
          </div>

        </section>

        {/* FOOTER */}

        <footer className="mt-8 border-t border-[#1F2937] py-6">
          <div className="flex flex-col justify-between gap-3 text-[9px] tracking-widest text-slate-600 sm:flex-row">

