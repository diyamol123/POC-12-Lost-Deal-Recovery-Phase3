        : [],
    [pkg]
  );

  const filteredResults = useMemo(() =&gt; {
    if (!pkg) return [];

    return pkg.results.filter(
      (result) =&gt;
        (group === &quot;ALL&quot; || result.group_key === group) &amp;&amp;
        (category === &quot;ALL&quot; || result.result_category === category) &amp;&amp;
        (quality === &quot;ALL&quot; || result.quality_status === quality)
    );
  }, [pkg, group, category, quality]);

  const clearFilters = () =&gt; {
