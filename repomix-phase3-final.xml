                className="flex items-center gap-2 rounded-lg border border-[#38BDF8]/30 bg-[#38BDF8]/10 px-4 py-3 text-[10px] font-semibold tracking-widest text-[#38BDF8] transition hover:bg-[#38BDF8]/20"
              >
                <Download className="h-4 w-4" />
                DOWNLOAD CSV
