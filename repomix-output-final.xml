def standardize(row):
    observed_at = datetime.strptime(row["date"], "%Y-%m-%d").strftime(
        "%Y-%m-%dT00:00:00Z"
    )

    return {
        "record_id": row["id"],
        "record_type": "lost_deal",
        "observed_at": observed_at,
        "entity_id": row["id"],
        "related_entity_id": "",
        "entity_name": row["company"],
        "category": row["reason"],
        "subcategory": row["product"],
        "status": row["priority"],
