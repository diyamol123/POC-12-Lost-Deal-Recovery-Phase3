        </div>

        {/* Content */}
        <div className="flex-1 space-y-4 overflow-y-auto p-5">
          {/* Selected item */}
          <section className="rounded-xl border border-[#38BDF8]/20 bg-[#0B1117] p-4">
            <div className="text-[9px] tracking-[0.2em] text-slate-500">
