            <div className="mt-5 rounded-xl border border-[#1F2937] bg-[#030712] p-4">

              <div className="text-[9px] tracking-widest text-slate-500">
                DEVELOPER SIGNATURE
              </div>

              <div className="mt-3 text-sm font-semibold">
