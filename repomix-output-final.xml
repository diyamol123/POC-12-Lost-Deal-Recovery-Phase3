@app.get("/api/intelligence/health")
def intelligence_health():
    status = _intelligence_status()

    if status["status"] == "validated":
        return {
            "status": "ok",
            "quality_status": "validated",
        }

    return {
        "status": status["status"],
        "detail": status.get("detail"),
    }


